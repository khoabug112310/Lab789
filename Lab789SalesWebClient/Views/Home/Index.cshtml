@model List<Lab789SalesWebClient.Models.Product>
@{
    ViewData["Title"] = "Kệ hàng";
    var products = Model ?? new List<Product>();
    var stockValue = products.Sum(p => p.Price * p.Quantity);
    var low = products.Count(p => p.Quantity > 0 && p.Quantity <= 10);
}

<header class="page-head">
    <div>
        <p class="page-kicker">Kệ hàng</p>
        <h1 class="page-title">Những gì đang còn bán.</h1>
        <p class="lede">Danh sách đi qua API bán hàng. Redis giữ bản đọc trong năm phút, rồi bị xóa khi có mặt hàng mới hoặc một đơn làm giảm tồn kho.</p>
    </div>
    <div class="actions">
        <a class="btn accent" asp-action="CreateProduct">Thêm mặt hàng</a>
        <a class="btn ghost" asp-action="Orders">Sổ đơn</a>
    </div>
</header>

<section class="stats">
    <article class="stat"><b>@products.Count</b><span>Mặt hàng</span></article>
    <article class="stat"><b>@low</b><span>Sắp hết</span></article>
    <article class="stat"><b>@stockValue.ToString("N0")</b><span>Giá trị tồn</span></article>
</section>

@if (products.Count == 0)
{
    <p class="empty">Kệ đang trống, hoặc API bán hàng chưa chạy ở cổng 5059.</p>
}
else
{
    <section class="catalog">
        @foreach (var item in products)
        {
            var rawImg = item.ImageUrl ?? item.ImageURL;
            var imgUrl = string.IsNullOrEmpty(rawImg)
                ? null
                : (rawImg.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? rawImg : $"http://localhost:5059{rawImg}");
            var initial = string.IsNullOrWhiteSpace(item.ProductName) ? "•" : item.ProductName[..1].ToUpperInvariant();
            <article class="sku">
                <div class="sku-photo">
                    @if (!string.IsNullOrEmpty(imgUrl))
                    {
                        <img src="@imgUrl" alt="@item.ProductName" />
                    }
                    else
                    {
                        @initial
                    }
                </div>
                <div class="sku-body">
                    <span class="pill quiet">@item.Category</span>
                    <h3>@item.ProductName</h3>
                    <p class="price">@item.Price.ToString("N0") <span class="muted">VNĐ</span></p>
                    @if (item.Quantity > 10)
                    {
                        <p class="muted" style="margin: 0;">Còn @item.Quantity</p>
                    }
                    else if (item.Quantity > 0)
                    {
                        <p class="pill wait" style="margin: 0;">Sắp hết · @item.Quantity</p>
                    }
                    else
                    {
                        <p class="pill no" style="margin: 0;">Hết hàng</p>
                    }
                    @if (item.Quantity > 0)
                    {
                        <a class="btn good" asp-action="CreateOrder" asp-route-productId="@item.Id">Đặt hàng</a>
                    }
                    else
                    {
                        <span class="btn ghost">Không đặt thêm được</span>
                    }
                </div>
            </article>
        }
    </section>
}
