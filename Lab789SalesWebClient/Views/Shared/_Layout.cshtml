<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Alder Bán hàng</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,560;9..144,650&family=IBM+Plex+Mono:wght@400;500&family=Outfit:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Mark(string a) => string.Equals(act, a, StringComparison.OrdinalIgnoreCase) ? "is-here" : "";
    var ordersHere = act.Equals("Orders", StringComparison.OrdinalIgnoreCase) || act.Equals("Order", StringComparison.OrdinalIgnoreCase) ? "is-here" : "";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var roles = User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role || c.Type == "role").Select(c => c.Value).Distinct().ToList();
    var returnUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
    var loginUrl = "http://localhost:5122/Account/Login?returnUrl=" + Uri.EscapeDataString(returnUrl);
}
<body class="shell">
    <aside class="rail">
        <a class="mark" asp-controller="Home" asp-action="Index">
            <span class="mark-badge">Bh</span>
            <span><small>Quầy hàng</small><strong>Alder</strong></span>
        </a>
        <nav>
            <a class="@Mark("Index")" asp-controller="Home" asp-action="Index">Kệ hàng <span>01</span></a>
            <a class="@Mark("CreateProduct")" asp-controller="Home" asp-action="CreateProduct">Thêm mặt hàng <span>02</span></a>
            <a class="@ordersHere" asp-controller="Home" asp-action="Orders">Sổ đơn <span>03</span></a>
            <a class="@Mark("CreateOrder")" asp-controller="Home" asp-action="CreateOrder">Lập đơn <span>04</span></a>
            <a href="http://localhost:5122/">Cổng Alder <span>5122</span></a>
            <a href="http://localhost:5192/">Nhân sự <span>5192</span></a>
        </nav>
        <div class="rail-foot">
            @if (signedIn)
            {
                <div class="who">
                    Phiên dùng chung
                    <b>@User.Identity!.Name</b>
                    <div class="role-row">
                        @foreach (var role in roles)
                        {
                            <span class="pill">@role</span>
                        }
                    </div>
                </div>
                <form action="http://localhost:5122/Account/Logout" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="btn ghost block">Đăng xuất</button>
                </form>
            }
            else
            {
                <a class="btn accent block" href="@loginUrl">Đăng nhập</a>
            }
        </div>
    </aside>
    <div class="stage">
        <div class="stage-inner">
            <main role="main">@RenderBody()</main>
            <p class="colophon">Alder Bán hàng · tồn kho giảm khi đơn được ghi nhận.</p>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
