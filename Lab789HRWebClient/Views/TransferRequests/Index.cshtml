@model List<Lab789HRWebClient.Models.DepartmentTransferItem>
@{
    ViewData["Title"] = "Điều chuyển";
    var currentStatus = ViewBag.CurrentStatus as string;
    var isManager = User.IsInRole("Manager") || User.IsInRole("Admin");
    var items = Model ?? new List<DepartmentTransferItem>();
    string Pill(string status) => status switch
    {
        "Approved" => "ok",
        "Rejected" => "no",
        _ => "wait"
    };
    string Label(string status) => status switch
    {
        "Approved" => "Đã duyệt",
        "Rejected" => "Đã từ chối",
        "Pending" => "Chờ duyệt",
        _ => status
    };
}

<header class="page-head">
    <div>
        <p class="page-kicker">Điều chuyển phòng ban</p>
        <h1 class="page-title">Đơn đang nằm trên bàn.</h1>
        <p class="lede">Khi đơn được duyệt, phòng ban của nhân viên đổi theo đơn và cả sổ nhân viên lẫn danh sách đơn được làm mới trong Redis.</p>
    </div>
    <a class="btn accent" asp-action="Create">Viết đơn</a>
</header>

@if (TempData["SuccessMessage"] != null)
{
    <p class="notice ok">@TempData["SuccessMessage"]</p>
}
@if (TempData["WarningMessage"] != null)
{
    <p class="notice warn">@TempData["WarningMessage"]</p>
}
@if (TempData["ErrorMessage"] != null)
{
    <p class="notice bad">@TempData["ErrorMessage"]</p>
}

<nav class="filters" aria-label="Lọc theo trạng thái">
    <a class="@(string.IsNullOrEmpty(currentStatus) ? "is-here" : "")" asp-action="Index">Tất cả</a>
    <a class="@(currentStatus == "Pending" ? "is-here" : "")" asp-action="Index" asp-route-status="Pending">Chờ duyệt</a>
    <a class="@(currentStatus == "Approved" ? "is-here" : "")" asp-action="Index" asp-route-status="Approved">Đã duyệt</a>
    <a class="@(currentStatus == "Rejected" ? "is-here" : "")" asp-action="Index" asp-route-status="Rejected">Đã từ chối</a>
</nav>

@if (items.Count == 0)
{
    <p class="empty">Không có đơn trong bộ lọc này.</p>
}
else
{
    <section class="slips">
        @foreach (var item in items)
        {
            <article class="slip">
                <header>
                    <span class="num">Đơn @item.Id</span>
                    <span class="pill @Pill(item.Status)">@Label(item.Status)</span>
                </header>
                <div>
                    <h3>@item.EmployeeName</h3>
                    <p class="muted" style="margin: 0;">@item.EmployeeEmail</p>
                </div>
                <p class="route"><span class="pill quiet">@item.FromDepartment</span> → <span class="pill quiet">@item.ToDepartment</span></p>
                <p class="reason">@item.Reason</p>
                <p class="muted" style="margin: 0;">Gửi @item.RequestDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                @if (!string.IsNullOrEmpty(item.ReviewedBy))
                {
                    <p class="muted" style="margin: 0;">
                        @item.ReviewedBy
                        @if (item.ReviewDate.HasValue)
                        {
                            <span> · @item.ReviewDate.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                        }
                        @if (!string.IsNullOrEmpty(item.ReviewComment))
                        {
                            <span> · “@item.ReviewComment”</span>
                        }
                    </p>
                }
                @if (item.Status == "Pending" && isManager)
                {
                    <div class="review-box">
                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Duyệt chuyển @item.EmployeeName sang @item.ToDepartment?');">
                            @Html.AntiForgeryToken()
                            <input class="field" type="text" name="comment" maxlength="500" placeholder="Ghi chú khi duyệt" />
                            <button class="btn good small" type="submit">Duyệt</button>
                        </form>
                        <form asp-action="Reject" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Từ chối đơn này?');">
                            @Html.AntiForgeryToken()
                            <input class="field" type="text" name="comment" maxlength="500" placeholder="Ghi chú khi từ chối" />
                            <button class="btn bad small" type="submit">Từ chối</button>
                        </form>
                    </div>
                }
                else if (item.Status == "Pending")
                {
                    <p class="muted" style="margin: 0;">Đơn đang chờ Manager hoặc Admin.</p>
                }
            </article>
        }
    </section>
}
