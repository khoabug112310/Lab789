@model Lab789SalesWebClient.Models.ProductViewModel
@{
    ViewData["Title"] = "Thêm mặt hàng";
}

<header class="page-head">
    <div>
        <p class="page-kicker">Mặt hàng mới</p>
        <h1 class="page-title">Đưa một món lên kệ.</h1>
        <p class="lede">Ảnh nhận JPG, JPEG, PNG hoặc GIF, tối đa 2 MB. API lưu file và trả về đường dẫn ảnh.</p>
    </div>
</header>

<form class="sheet" asp-action="CreateProduct" method="post" enctype="multipart/form-data" style="max-width: 680px;">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="form-grid">
        <div>
            <label class="lbl" asp-for="ProductName">Tên mặt hàng</label>
            <input class="field" asp-for="ProductName" placeholder="Chuột không dây" />
            <span asp-validation-for="ProductName"></span>
        </div>
        <div>
            <label class="lbl" asp-for="Category">Nhóm hàng</label>
            <input class="field" asp-for="Category" placeholder="Electronics" />
            <span asp-validation-for="Category"></span>
        </div>
        <div class="form-row">
            <div>
                <label class="lbl" asp-for="Price">Giá (VNĐ)</label>
                <input class="field" asp-for="Price" type="number" step="0.01" min="0" />
                <span asp-validation-for="Price"></span>
            </div>
            <div>
                <label class="lbl" asp-for="Quantity">Số lượng</label>
                <input class="field" asp-for="Quantity" type="number" min="0" />
                <span asp-validation-for="Quantity"></span>
            </div>
        </div>
        <div>
            <label class="lbl" asp-for="Image">Ảnh</label>
            <input class="field" asp-for="Image" type="file" accept=".jpg,.jpeg,.png,.gif" />
            <span asp-validation-for="Image"></span>
        </div>
        <div class="form-actions">
            <a class="btn ghost" asp-action="Index">Về kệ hàng</a>
            <button class="btn accent" type="submit">Lưu mặt hàng</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
