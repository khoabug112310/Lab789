@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
    ViewData["Bare"] = true;
}

<section class="gate">
    <div class="gate-copy">
        <p class="page-kicker">Alder</p>
        <h1>Yêu cầu vừa rồi không hoàn tất.</h1>
        @if (Model.ShowRequestId)
        {
            <p class="lede">Mã yêu cầu: <span class="num">@Model.RequestId</span></p>
        }
        <a class="btn accent" href="/">Về bàn làm việc</a>
    </div>
</section>
