@model List<Lab789SalesWebClient.Models.Order>
@{
    ViewData["Title"] = "Sổ đơn";
    var orders = Model ?? new List<Order>();
    var total = orders.Sum(o => o.Amount);
}

<header class="page-head">
    <div>
        <p class="page-kicker">Sổ đơn</p>
        <h1 class="page-title">Những đơn đã ghi.</h1>
        <p class="lede">Mỗi dòng là một lần bán. Thành tiền bằng đơn giá nhân số lượng tại thời điểm đọc sổ.</p>
    </div>
    <div class="actions">
        <a class="btn accent" asp-action="CreateOrder">Lập đơn</a>
        <a class="btn ghost" asp-action="Index">Về kệ hàng</a>
    </div>
</header>

<section class="stats">
    <article class="stat"><b>@orders.Count</b><span>Đơn</span></article>
    <article class="stat"><b>@orders.Sum(o => o.Quantity)</b><span>Món đã bán</span></article>
    <article class="stat"><b>@total.ToString("N0")</b><span>Tổng tiền</span></article>
</section>

@if (orders.Count == 0)
{
    <p class="empty">Chưa có đơn, hoặc API bán hàng chưa chạy ở cổng 5059.</p>
}
else
{
    <div class="ledger-wrap">
        <table class="ledger">
            <thead>
                <tr>
                    <th>Đơn</th>
                    <th>Mã hàng</th>
                    <th>Tên</th>
                    <th>Ngày</th>
                    <th class="end">Số lượng</th>
                    <th class="end">Đơn giá</th>
                    <th class="end">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in orders)
                {
                    <tr>
                        <td class="num">@order.Id</td>
                        <td class="num">@order.ProductId</td>
                        <td>@(string.IsNullOrEmpty(order.ProductName) ? "Không rõ" : order.ProductName)</td>
                        <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="end">@order.Quantity</td>
                        <td class="end">@order.Price.ToString("N0")</td>
                        <td class="end pay">@order.Amount.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
