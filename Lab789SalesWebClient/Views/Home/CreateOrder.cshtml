@model Lab789SalesWebClient.Models.OrderViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Lập đơn";
}

<header class="page-head">
    <div>
        <p class="page-kicker">Đơn mới</p>
        <h1 class="page-title">Ghi một lần bán.</h1>
        <p class="lede">Chỉ hiện mặt hàng còn tồn. Nếu số lượng vượt quá kho, API từ chối và không trừ hàng.</p>
    </div>
</header>

<form class="sheet" asp-action="CreateOrder" method="post" style="max-width: 640px;">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="form-grid">
        <div>
            <label class="lbl" asp-for="ProductId">Mặt hàng</label>
            <select class="field" asp-for="ProductId" asp-items="@(ViewBag.Products as IEnumerable<SelectListItem>)">
                <option value="0">Chọn mặt hàng còn hàng</option>
            </select>
            <span asp-validation-for="ProductId"></span>
        </div>
        <div>
            <label class="lbl" asp-for="OrderDate">Ngày đặt</label>
            <input class="field" asp-for="OrderDate" type="datetime-local" value="@Model.OrderDate.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="OrderDate"></span>
        </div>
        <div>
            <label class="lbl" asp-for="Quantity">Số lượng</label>
            <input class="field" asp-for="Quantity" type="number" min="1" />
            <span asp-validation-for="Quantity"></span>
        </div>
        <div class="form-actions">
            <a class="btn ghost" asp-action="Orders">Về sổ đơn</a>
            <button class="btn accent" type="submit">Ghi đơn</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
