@model List<Lab789HRWebClient.Models.Employee>
@{
    ViewData["Title"] = "Sổ nhân viên";
    string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "•";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][..1].ToUpperInvariant();
        return string.Concat(parts[0][..1], parts[^1][..1]).ToUpperInvariant();
    }
}

@if (User.Identity?.IsAuthenticated != true)
{
    var loginUrl = "http://localhost:5122/Account/Login?returnUrl=" + Uri.EscapeDataString("http://localhost:5192/Home/Index");
    <section class="locked">
        <p class="page-kicker">Sổ nhân viên</p>
        <h1 class="page-title">Hồ sơ chỉ mở sau khi đăng nhập.</h1>
        <p class="lede">Dùng cổng Alder. Phiên đó được phòng nhân sự nhận ra mà không cần đăng nhập lần nữa.</p>
        <a class="btn accent" href="@loginUrl">Đến cổng đăng nhập</a>
    </section>
}
else
{
    var people = Model ?? new List<Employee>();
    var departments = people.Select(e => e.Department).Where(d => !string.IsNullOrWhiteSpace(d)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    var payroll = people.Sum(e => e.Salary);

    <header class="page-head">
        <div>
            <p class="page-kicker">Sổ nhân viên</p>
            <h1 class="page-title">Người đang làm việc.</h1>
            <p class="lede">Danh sách lấy từ API nhân sự. Lần đọc sau trong năm phút có thể đến từ Redis, cho đến khi có hồ sơ mới hoặc một đơn chuyển phòng được duyệt.</p>
        </div>
        <a class="btn accent" asp-action="Create">Thêm hồ sơ</a>
    </header>

    <section class="stats">
        <article class="stat"><b>@people.Count</b><span>Nhân viên</span></article>
        <article class="stat"><b>@departments</b><span>Phòng ban</span></article>
        <article class="stat"><b>@payroll.ToString("N0")</b><span>Tổng lương</span></article>
    </section>

    @if (people.Count == 0)
    {
        <p class="empty">Chưa có hồ sơ, hoặc API nhân sự chưa chạy ở cổng 5213.</p>
    }
    else
    {
        <ol class="roster">
            @foreach (var item in people)
            {
                <li>
                    <span class="avatar">@Initials(item.FullName)</span>
                    <div class="person">
                        <b>@item.FullName</b>
                        <span>@item.Email · @item.Position</span>
                    </div>
                    <span class="stamp pill quiet">@item.Department</span>
                    <span class="pay">@item.Salary.ToString("N0")</span>
                </li>
            }
        </ol>
    }
}
