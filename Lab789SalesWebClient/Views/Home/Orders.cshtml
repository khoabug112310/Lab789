@model List<Lab789SalesWebClient.Models.Order>

@{
    ViewData["Title"] = "Order History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-receipt-cutoff text-success me-2"></i>Order History</h2>
        <p class="text-muted mb-0">List of all recorded customer purchases and orders</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="CreateOrder" class="btn btn-success shadow-sm btn-rounded">
            <i class="bi bi-cart-plus me-1"></i> Create New Order
        </a>
        <a asp-action="Index" class="btn btn-outline-dark shadow-sm btn-rounded">
            <i class="bi bi-arrow-left me-1"></i> Back to Products
        </a>
    </div>
</div>

<div class="card card-custom p-3 mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="text-center" style="width: 90px;">Order ID</th>
                    <th class="text-center" style="width: 100px;">Product ID</th>
                    <th>Product Name</th>
                    <th>Order Date</th>
                    <th class="text-center">Quantity</th>
                    <th class="text-end">Unit Price</th>
                    <th class="text-end">Total Amount</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="text-center font-monospace fw-bold text-secondary">#@order.Id</td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">@order.ProductId</span>
                            </td>
                            <td class="fw-bold text-dark">
                                @(string.IsNullOrEmpty(order.ProductName) ? "N/A" : order.ProductName)
                            </td>
                            <td>
                                <i class="bi bi-clock text-muted me-1"></i>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")
                            </td>
                            <td class="text-center fw-bold">@order.Quantity</td>
                            <td class="text-end text-muted">@order.Price.ToString("N0") VNĐ</td>
                            <td class="text-end fw-bold text-success fs-6">
                                @order.Amount.ToString("N0") <small class="text-muted">VNĐ</small>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No orders placed yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
