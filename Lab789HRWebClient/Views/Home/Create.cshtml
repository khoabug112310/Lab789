@model Lab789HRWebClient.Models.EmployeeViewModel
@{
    ViewData["Title"] = "Thêm hồ sơ";
}

<header class="page-head">
    <div>
        <p class="page-kicker">Hồ sơ mới</p>
        <h1 class="page-title">Ghi một người vào sổ.</h1>
        <p class="lede">Email không được trùng. Sau khi lưu, danh sách nhân viên trong Redis được xóa để lần mở sổ sau đọc lại từ cơ sở dữ liệu.</p>
    </div>
</header>

<form class="sheet" asp-action="Create" method="post" style="max-width: 640px;">
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="form-grid">
        <div>
            <label class="lbl" asp-for="FullName">Họ và tên</label>
            <input class="field" asp-for="FullName" placeholder="Nguyễn An" />
            <span asp-validation-for="FullName"></span>
        </div>
        <div>
            <label class="lbl" asp-for="Email">Email</label>
            <input class="field" asp-for="Email" placeholder="an@example.com" />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="form-row">
            <div>
                <label class="lbl" asp-for="Department">Phòng ban</label>
                <input class="field" asp-for="Department" list="departments" placeholder="IT" />
                <datalist id="departments">
                    <option value="IT"></option>
                    <option value="HR"></option>
                    <option value="Finance"></option>
                    <option value="Sales"></option>
                    <option value="Marketing"></option>
                    <option value="Operations"></option>
                    <option value="Legal"></option>
                    <option value="Customer Support"></option>
                </datalist>
                <span asp-validation-for="Department"></span>
            </div>
            <div>
                <label class="lbl" asp-for="Position">Vị trí</label>
                <input class="field" asp-for="Position" placeholder="Developer" />
                <span asp-validation-for="Position"></span>
            </div>
        </div>
        <div>
            <label class="lbl" asp-for="Salary">Lương</label>
            <input class="field" asp-for="Salary" type="number" step="0.01" min="0" />
            <span asp-validation-for="Salary"></span>
        </div>
        <div class="form-actions">
            <a class="btn ghost" asp-action="Index">Về sổ</a>
            <button class="btn accent" type="submit">Lưu hồ sơ</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
