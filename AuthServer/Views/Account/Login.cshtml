@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["Bare"] = true;
    var returnUrl = ViewBag.ReturnUrl as string;
}

<section class="gate">
    <div class="gate-copy">
        <p class="page-kicker">Alder</p>
        <h1>Cổng này mở cả hai phòng.</h1>
        <p class="lede">Phiên đăng nhập được các ứng dụng nhân sự và bán hàng đọc lại. API vẫn dùng JWT riêng khi gọi từ Swagger.</p>
        <ul class="accounts">
            <li><b>Quản trị</b><code>admin@example.com</code></li>
            <li><b>Quản lý</b><code>manager@example.com</code></li>
            <li><b>Nhân viên</b><code>employee@example.com</code></li>
            <li><b>Kinh doanh</b><code>sales@example.com</code></li>
        </ul>
        <p class="lede">Mật khẩu mẫu: Password123!</p>
    </div>
    <div class="gate-form">
        <form class="sheet" asp-controller="Account" asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <p class="page-kicker">Đăng nhập</p>
            <h2>Vào Alder</h2>
            <p class="muted" style="margin-top: 0;">Dùng email và mật khẩu đã được tạo sẵn.</p>
            <div asp-validation-summary="ModelOnly" role="alert"></div>
            <div class="form-grid">
                <div>
                    <label class="lbl" for="email">Email</label>
                    <input id="email" class="field" type="email" name="email" placeholder="ban@example.com" required autofocus />
                </div>
                <div>
                    <label class="lbl" for="password">Mật khẩu</label>
                    <input id="password" class="field" type="password" name="password" placeholder="Ít nhất 6 ký tự" required />
                </div>
                <button type="submit" class="btn accent block">Đăng nhập</button>
            </div>
            @if (!string.IsNullOrEmpty(returnUrl) && returnUrl != "/")
            {
                <p class="muted" style="margin-bottom: 0;">Sau khi vào sẽ trở lại <span class="num">@returnUrl</span></p>
            }
        </form>
    </div>
</section>
