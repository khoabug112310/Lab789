@{
    ViewData["Title"] = "Bàn làm việc";
    var roles = User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role || c.Type == "role").Select(c => c.Value).Distinct();
    var signedIn = User.Identity?.IsAuthenticated == true;
}

<header class="page-head">
    <div>
        <p class="page-kicker">Một cổng cho cả hệ thống</p>
        <h1 class="page-title">Đăng nhập một lần, mở nhân sự và bán hàng.</h1>
        <p class="lede">Alder phát phiên đăng nhập dùng chung. API nhân sự và bán hàng vẫn nhận JWT, còn danh sách nhân viên, đơn chuyển phòng, sản phẩm và đơn hàng vẫn đi qua Redis.</p>
    </div>
    @if (!signedIn)
    {
        <a class="btn accent" asp-controller="Account" asp-action="Login">Vào cổng</a>
    }
</header>

@if (signedIn)
{
    <section class="panel" style="margin-bottom: 22px;">
        <p class="page-kicker">Phiên hiện tại</p>
        <h2 style="font-family: var(--serif); font-weight: 560; margin: 0 0 8px;">@User.Identity!.Name</h2>
        <div class="role-row">
            @foreach (var role in roles)
            {
                <span class="pill quiet">@role</span>
            }
        </div>
    </section>
}

<section class="doors">
    <a class="door" href="http://localhost:5192/">
        <em>01</em>
        <div>
            <h2>Nhân sự</h2>
            <p>Sổ nhân viên, lương, và đơn xin chuyển phòng. Manager hoặc Admin mới duyệt được.</p>
        </div>
        <span class="pill quiet">5192</span>
    </a>
    <a class="door" href="http://localhost:5247/">
        <em>02</em>
        <div>
            <h2>Bán hàng</h2>
            <p>Kệ hàng có ảnh, lập đơn, trừ tồn kho đúng số lượng vừa bán.</p>
        </div>
        <span class="pill quiet">5247</span>
    </a>
    <a class="door" href="http://localhost:5213/swagger">
        <em>03</em>
        <div>
            <h2>API nhân sự</h2>
            <p>Swagger cho nhân viên và điều chuyển. Gắn Bearer token khi gọi tay.</p>
        </div>
        <span class="pill quiet">5213</span>
    </a>
    <a class="door" href="http://localhost:5059/swagger">
        <em>04</em>
        <div>
            <h2>API bán hàng</h2>
            <p>Swagger cho sản phẩm và đơn hàng. Ảnh lưu dưới wwwroot/images.</p>
        </div>
        <span class="pill quiet">5059</span>
    </a>
</section>

<section style="margin-top: 28px;">
    <p class="page-kicker">Tài khoản mẫu</p>
    <h2 style="font-family: var(--serif); font-weight: 560; margin: 0 0 12px;">Mật khẩu chung Password123!</h2>
    <ul class="accounts">
        <li><b>Quản trị</b><code>admin@example.com</code><span class="pill quiet">Admin, Manager</span></li>
        <li><b>Quản lý</b><code>manager@example.com</code><span class="pill quiet">Manager</span></li>
        <li><b>Nhân viên</b><code>employee@example.com</code><span class="pill quiet">Employee</span></li>
        <li><b>Kinh doanh</b><code>sales@example.com</code><span class="pill quiet">Sales</span></li>
    </ul>
</section>
