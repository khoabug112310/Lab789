@{
    ViewData["Title"] = "SSO Authentication Portal";
    var roles = User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role || c.Type == "role").Select(c => c.Value).Distinct();
}

<div class="container my-4">
    <!-- Header Banner -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4 bg-gradient text-white" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <span class="badge bg-light text-primary px-3 py-2 rounded-pill fw-semibold mb-2">
                        <i class="bi bi-shield-check me-1"></i> Central Identity & SSO Hub
                    </span>
                    <h2 class="display-6 fw-bold mb-2">Lab789 Authentication Portal</h2>
                    <p class="mb-0 text-white-50 fs-6">Hệ thống xác thực tập trung dùng chung cho toàn bộ các dịch vụ HR & Sales</p>
                </div>
                <div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="bg-white bg-opacity-10 border border-white border-opacity-25 rounded-3 p-3 text-white">
                            <div class="small text-white-50 mb-1">Tài khoản đang đăng nhập:</div>
                            <div class="fw-bold fs-6"><i class="bi bi-person-circle me-1"></i> @User.Identity.Name</div>
                            <div class="mt-2 d-flex flex-wrap gap-1 align-items-center">
                                <span class="small text-white-50 me-1">Vai trò:</span>
                                @foreach (var r in roles)
                                {
                                    <span class="badge bg-warning text-dark fw-semibold">@r</span>
                                }
                            </div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="mt-3">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-light btn-sm w-100">
                                    <i class="bi bi-box-arrow-right me-1"></i> Đăng Xuất (Logout)
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-lg px-4 shadow fw-bold text-primary">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập Ngay
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation to Running Services -->
    <h4 class="fw-bold mb-3 text-secondary"><i class="bi bi-grid-fill text-primary me-2"></i>Các Ứng Dụng Trong Hệ Thống Đang Chạy</h4>
    <p class="text-muted small mb-4">Nhấp vào bất kỳ dịch vụ nào dưới đây để truy cập ngay. Phiên đăng nhập SSO sẽ tự động được nhận diện trên tất cả ứng dụng web.</p>

    <div class="row g-4">
        <!-- HR Web Client Card -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 hover-shadow transition">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                            <i class="bi bi-people-fill fs-2"></i>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-1 rounded-pill">
                            Port 5192
                        </span>
                    </div>
                    <h5 class="fw-bold mb-1">HR Management Client</h5>
                    <p class="text-muted small mb-4 flex-grow-1">
                        Quản lý hồ sơ nhân viên, mức lương, phòng ban và <strong>quy trình nộp & duyệt đơn chuyển phòng ban</strong>.
                    </p>
                    <div class="d-grid gap-2">
                        <a href="http://localhost:5192/" target="_blank" class="btn btn-primary fw-semibold">
                            <i class="bi bi-arrow-up-right-square me-1"></i> Vào HR Client (5192)
                        </a>
                        <a href="http://localhost:5192/TransferRequests" target="_blank" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-arrow-left-right me-1"></i> Đơn Xin Chuyển Phòng Ban
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sales Web Client Card -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 hover-shadow transition">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="bg-warning bg-opacity-10 text-dark rounded-3 p-3">
                            <i class="bi bi-shop fs-2 text-warning"></i>
                        </div>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-1 rounded-pill">
                            Port 5247
                        </span>
                    </div>
                    <h5 class="fw-bold mb-1">Sales Management Client</h5>
                    <p class="text-muted small mb-4 flex-grow-1">
                        Danh mục sản phẩm, tải ảnh lên, đặt hàng, quản lý số lượng tồn kho tự động.
                    </p>
                    <div class="d-grid gap-2">
                        <a href="http://localhost:5247/" target="_blank" class="btn btn-warning text-dark fw-semibold">
                            <i class="bi bi-arrow-up-right-square me-1"></i> Vào Sales Client (5247)
                        </a>
                        <a href="http://localhost:5247/Home/Orders" target="_blank" class="btn btn-outline-dark btn-sm">
                            <i class="bi bi-receipt me-1"></i> Lịch Sử Đơn Hàng
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Web APIs & Swagger Card -->
        <div class="col-md-12 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 hover-shadow transition">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="bg-info bg-opacity-10 text-info rounded-3 p-3">
                            <i class="bi bi-code-slash fs-2"></i>
                        </div>
                        <span class="badge bg-info bg-opacity-10 text-info border border-info px-3 py-1 rounded-pill">
                            JWT & Redis
                        </span>
                    </div>
                    <h5 class="fw-bold mb-1">Backend Web APIs (Swagger)</h5>
                    <p class="text-muted small mb-4 flex-grow-1">
                        Tài liệu RESTful API, hỗ trợ xác thực <strong>JWT Bearer</strong> trực tiếp trên Swagger và lưu trữ đệm <strong>Redis Cache</strong>.
                    </p>
                    <div class="d-grid gap-2">
                        <a href="http://localhost:5213/swagger" target="_blank" class="btn btn-outline-info text-dark fw-semibold">
                            <i class="bi bi-file-code me-1"></i> Swagger HR API (Port 5213)
                        </a>
                        <a href="http://localhost:5059/swagger" target="_blank" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-file-code me-1"></i> Swagger Sales API (Port 5059)
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Account Cheat Sheet -->
    <div class="card shadow-sm border-0 rounded-4 mt-4 bg-light">
        <div class="card-body p-4">
            <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-key-fill text-warning me-2"></i>Tài Khoản Đăng Nhập Hệ Thống (Mật khẩu chung: <code>Password123!</code>)</h6>
            <div class="row g-3 small">
                <div class="col-sm-6 col-md-3">
                    <div class="p-2 bg-white rounded-3 border">
                        <div class="fw-bold text-primary">Quản Trị Viên (Admin & Manager)</div>
                        <div><code>admin@example.com</code></div>
                        <span class="badge bg-primary">Admin, Manager</span>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="p-2 bg-white rounded-3 border">
                        <div class="fw-bold text-success">Quản Lý Duyệt Đơn (Manager)</div>
                        <div><code>manager@example.com</code></div>
                        <span class="badge bg-success">Manager</span>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="p-2 bg-white rounded-3 border">
                        <div class="fw-bold text-info">Nhân Viên (Employee)</div>
                        <div><code>employee@example.com</code></div>
                        <span class="badge bg-info text-dark">Employee</span>
                    </div>
                </div>
                <div class="col-sm-6 col-md-3">
                    <div class="p-2 bg-white rounded-3 border">
                        <div class="fw-bold text-warning">Kinh Doanh (Sales)</div>
                        <div><code>sales@example.com</code></div>
                        <span class="badge bg-warning text-dark">Sales</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>