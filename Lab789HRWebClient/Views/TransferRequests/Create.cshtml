@model Lab789HRWebClient.Models.CreateDepartmentTransferViewModel
@{
    ViewData["Title"] = "Viết đơn chuyển phòng";
}

<header class="page-head">
    <div>
        <p class="page-kicker">Đơn mới</p>
        <h1 class="page-title">Xin chuyển sang phòng khác.</h1>
        <p class="lede">Không gửi được nếu nhân viên đã ở phòng đó, hoặc đang có một đơn chờ duyệt.</p>
    </div>
</header>

<form class="sheet" asp-action="Create" method="post" style="max-width: 680px;">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" role="alert"></div>
    <div class="form-grid">
        <div>
            <label class="lbl" asp-for="EmployeeId">Nhân viên</label>
            <select class="field" asp-for="EmployeeId" asp-items="Model.EmployeeList">
                <option value="">Chọn người cần chuyển</option>
            </select>
            <span asp-validation-for="EmployeeId"></span>
        </div>
        <div>
            <label class="lbl" asp-for="ToDepartment">Phòng muốn đến</label>
            <select class="field" asp-for="ToDepartment" asp-items="Model.DepartmentList">
                <option value="">Chọn phòng ban</option>
            </select>
            <span asp-validation-for="ToDepartment"></span>
        </div>
        <div>
            <label class="lbl" asp-for="Reason">Lý do</label>
            <textarea class="field" asp-for="Reason" placeholder="Vì sao người này nên sang phòng mới"></textarea>
            <span asp-validation-for="Reason"></span>
        </div>
        <div class="form-actions">
            <a class="btn ghost" asp-action="Index">Về danh sách đơn</a>
            <button class="btn accent" type="submit">Nộp đơn</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
