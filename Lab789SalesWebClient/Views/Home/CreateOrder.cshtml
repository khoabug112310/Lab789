@model Lab789SalesWebClient.Models.OrderViewModel

@{
    ViewData["Title"] = "Create New Order";
}

<div class="row justify-content-center my-4">
    <div class="col-md-7 col-lg-6">
        <div class="card card-custom p-4 shadow-sm border-0">
            <div class="text-center mb-4">
                <div class="bg-success-subtle text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 60px; height: 60px;">
                    <i class="bi bi-cart-plus fs-2"></i>
                </div>
                <h3 class="fw-bold mb-1">Create New Order</h3>
                <p class="text-muted fs-7">Select a product and specify quantity to place an order</p>
            </div>

            <form asp-action="CreateOrder" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="ProductId" class="form-label fw-semibold">Select Product</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-box"></i></span>
                        <select asp-for="ProductId" asp-items="@(ViewBag.Products as IEnumerable<SelectListItem>)" class="form-select fs-6">
                            <option value="0">-- Select Product --</option>
                        </select>
                    </div>
                    <span asp-validation-for="ProductId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="OrderDate" class="form-label fw-semibold">Order Date</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span>
                        <input asp-for="OrderDate" type="datetime-local" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <span asp-validation-for="OrderDate" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Quantity" class="form-label fw-semibold">Quantity</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-calculator"></i></span>
                        <input asp-for="Quantity" type="number" min="1" class="form-control" value="1" />
                    </div>
                    <span asp-validation-for="Quantity" class="text-danger small"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success btn-lg shadow-sm btn-rounded">
                        <i class="bi bi-check-lg me-1"></i> Submit Order
                    </button>
                    <a asp-action="Orders" class="btn btn-outline-secondary btn-rounded mt-1">
                        <i class="bi bi-arrow-left me-1"></i> Cancel & Back to Orders
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
