@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}
<header class="page-head">
    <div>
        <p class="page-kicker">Lỗi</p>
        <h1 class="page-title">Yêu cầu vừa rồi không hoàn tất.</h1>
        @if (Model.ShowRequestId)
        {
            <p class="lede">Mã yêu cầu: <span class="num">@Model.RequestId</span></p>
        }
        <a class="btn accent" asp-controller="Home" asp-action="Index">Về sổ nhân viên</a>
    </div>
</header>
