@model Lab789SalesWebClient.Models.ProductViewModel

@{
    ViewData["Title"] = "Add New Product";
}

<div class="row justify-content-center my-4">
    <div class="col-md-7 col-lg-6">
        <div class="card card-custom p-4 shadow-sm border-0">
            <div class="text-center mb-4">
                <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 60px; height: 60px;">
                    <i class="bi bi-box-seam fs-2"></i>
                </div>
                <h3 class="fw-bold mb-1">Add New Product</h3>
                <p class="text-muted fs-7">Fill in details below to register a new product item</p>
            </div>

            <form asp-action="CreateProduct" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="ProductName" class="form-label fw-semibold">Product Name</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-tag"></i></span>
                        <input asp-for="ProductName" class="form-control" placeholder="e.g. Wireless Mouse" />
                    </div>
                    <span asp-validation-for="ProductName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label fw-semibold">Category</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-folder"></i></span>
                        <input asp-for="Category" class="form-control" placeholder="e.g. Electronics" />
                    </div>
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-semibold">Price (VNĐ)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-currency-dollar"></i></span>
                            <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Quantity" class="form-label fw-semibold">Quantity</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-stack"></i></span>
                            <input asp-for="Quantity" type="number" class="form-control" placeholder="10" />
                        </div>
                        <span asp-validation-for="Quantity" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Image" class="form-label fw-semibold">Product Image (JPG/PNG/GIF, Max 2MB)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-image"></i></span>
                        <input asp-for="Image" type="file" class="form-control" accept=".jpg,.jpeg,.png,.gif" />
                    </div>
                    <span asp-validation-for="Image" class="text-danger small"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg shadow-sm btn-rounded">
                        <i class="bi bi-check-circle me-1"></i> Save Product
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-rounded mt-1">
                        <i class="bi bi-arrow-left me-1"></i> Cancel & Back to Catalog
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
