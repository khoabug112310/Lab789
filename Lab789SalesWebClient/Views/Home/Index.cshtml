@model List<Lab789SalesWebClient.Models.Product>

@{
    ViewData["Title"] = "Product Catalog";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-grid-fill text-primary me-2"></i>Product Catalog</h2>
        <p class="text-muted mb-0">Manage and browse available inventory items</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="CreateProduct" class="btn btn-primary shadow-sm btn-rounded">
            <i class="bi bi-plus-lg me-1"></i> Add New Product
        </a>
        <a asp-action="Orders" class="btn btn-outline-dark shadow-sm btn-rounded">
            <i class="bi bi-receipt me-1"></i> View Orders
        </a>
    </div>
</div>

<div class="card card-custom p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th class="text-center" style="width: 100px;">Image</th>
                    <th>Product Name</th>
                    <th>Category</th>
                    <th class="text-end">Price</th>
                    <th class="text-center">Stock Quantity</th>
                    <th class="text-center" style="width: 140px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var rawImg = item.ImageUrl ?? item.ImageURL;
                        var imgUrl = string.IsNullOrEmpty(rawImg) 
                            ? null 
                            : (rawImg.StartsWith("http") ? rawImg : $"http://localhost:5059{rawImg}");
                        <tr>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(imgUrl))
                                {
                                    <img src="@imgUrl" alt="@item.ProductName" class="rounded shadow-sm" style="width: 60px; height: 60px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="bg-light rounded d-flex align-items-center justify-content-center mx-auto text-muted" style="width: 60px; height: 60px;">
                                        <i class="bi bi-image fs-4"></i>
                                    </div>
                                }
                            </td>
                            <td class="fw-bold text-dark">@item.ProductName</td>
                            <td>
                                <span class="badge bg-secondary rounded-pill px-3 py-2 fw-normal">@item.Category</span>
                            </td>
                            <td class="text-end fw-bold text-success fs-6">
                                @item.Price.ToString("N0") <small class="text-muted">VNĐ</small>
                            </td>
                            <td class="text-center">
                                @if (item.Quantity > 10)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                                        <i class="bi bi-check-circle me-1"></i> @item.Quantity in stock
                                    </span>
                                }
                                else if (item.Quantity > 0)
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill">
                                        <i class="bi bi-exclamation-triangle me-1"></i> Low: @item.Quantity left
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill">
                                        <i class="bi bi-x-circle me-1"></i> Out of Stock
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="CreateOrder" asp-route-productId="@item.Id" class="btn btn-sm btn-success btn-rounded w-100">
                                    <i class="bi bi-cart-plus me-1"></i> Order
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No products found in inventory.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
